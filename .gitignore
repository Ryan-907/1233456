# --- credentials: never commit -------------------------------------------
.env
.env.*
secrets.json
*.key

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- latex build products -------------------------------------------------
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
